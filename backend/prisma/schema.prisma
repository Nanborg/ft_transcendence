// Configuration de Prisma (Spécifique à la Version 7)
generator client {
  provider = "prisma-client-js"
}

// Connexion à la Base de Données
datasource db {
  provider = "postgresql"
}

// Modèle de l'Utilisateur
model User {
  id                      Int              @id @default(autoincrement())
  email                   String           @unique
  username                String           @unique
  password                String?
  fortyTwoId              Int?             @unique
  avatar                  String?
  roomsOwned              Room[]
  rooms                   RoomPlayer[]
  refreshTokens           RefreshToken[]
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
  sentRequests            Friendship[]     @relation("SentRequests")
  receivedRequests        Friendship[]     @relation("ReceivedRequests")
  playerStats             PlayerRunStats[]
  sentChatMessages        ChatMessage[]    @relation("ChatMessageSender")
  receivedChatMessages    ChatMessage[]    @relation("ChatMessageRecipient")
  createdBlocks           UserBlock[]      @relation("Blocker")
  receivedBlocks          UserBlock[]      @relation("Blocked")
  sentGameInvitations     GameInvitation[] @relation("GameInvitationSender")
  receivedGameInvitations GameInvitation[] @relation("GameInvitationRecipient")
}

model Room {
  id              String           @id
  name            String?          @unique
  ownerId         Int
  status          String           @default("waiting")
  owner           User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  players         RoomPlayer[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  chatMessages    ChatMessage[]
  gameInvitations GameInvitation[]
}

model RoomPlayer {
  id       Int      @id @default(autoincrement())
  roomId   String
  userId   Int
  ready    Boolean  @default(false)
  room     Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime @default(now())

  @@unique([roomId, userId])
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime
  isRevoked Boolean  @default(false)
}

model GameRun {
  id              Int              @id @default(autoincrement())
  roomId          String
  won             Boolean
  lost            Boolean
  abandoned       Boolean
  durationSeconds Int
  stats           PlayerRunStats[]
  createdAt       DateTime         @default(now())
}

model PlayerRunStats {
  id             Int     @id @default(autoincrement())
  gameRunId      Int
  gameRun        GameRun @relation(fields: [gameRunId], references: [id], onDelete: Cascade)
  userId         Int
  user           User    @relation(fields: [userId], references: [id])
  deaths         Int
  damageDealt    Int
  damageReceived Int
  goldEarned     Int     @default(0)
  upgrade1       Int
  upgrade2       Int
  upgrade3       Int
}

enum ChatMessageType {
  TEXT
  GAME_INVITATION
  GAME_NOTIFICATION
}

enum GameInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}

model ChatMessage {
  id          Int             @id @default(autoincrement())
  senderId    Int?
  recipientId Int?
  roomId      String?
  type        ChatMessageType @default(TEXT)
  content     String
  createdAt   DateTime        @default(now())
  readAt      DateTime?

  sender     User?           @relation("ChatMessageSender", fields: [senderId], references: [id], onDelete: SetNull)
  recipient  User?           @relation("ChatMessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  room       Room?           @relation(fields: [roomId], references: [id], onDelete: Cascade)
  invitation GameInvitation?

  @@index([roomId, createdAt])
  @@index([senderId, recipientId, createdAt])
  @@index([recipientId, senderId, createdAt])
  @@index([recipientId, readAt])
}

model UserBlock {
  blockerId Int
  blockedId Int
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

model GameInvitation {
  id          Int                  @id @default(autoincrement())
  messageId   Int                  @unique
  senderId    Int?
  recipientId Int
  roomId      String?
  status      GameInvitationStatus @default(PENDING)
  createdAt   DateTime             @default(now())
  expiresAt   DateTime
  respondedAt DateTime?

  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  sender    User?       @relation("GameInvitationSender", fields: [senderId], references: [id], onDelete: SetNull)
  recipient User        @relation("GameInvitationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  room      Room?       @relation(fields: [roomId], references: [id], onDelete: SetNull)

  @@index([recipientId, status, createdAt])
  @@index([senderId, createdAt])
  @@index([roomId])
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

model Friendship {
  id       Int              @id @default(autoincrement())
  userId   Int
  friendId Int
  status   FriendshipStatus @default(PENDING)

  user   User @relation("SentRequests", fields: [userId], references: [id], onDelete: Cascade)
  friend User @relation("ReceivedRequests", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
}
