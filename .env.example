# Example file committed to Git.
# Copy to .env and replace secrets locally.

# PostgreSQL
POSTGRES_DB=transcendence
POSTGRES_USER=transcendence
# Dev placeholder.
POSTGRES_PASSWORD=transcendence_dev_only
POSTGRES_PORT=5432

# Ports
BACKEND_PORT=3000
FRONTEND_PORT=5173
GAMEPLAY_PORT=7000

# URLs
DATABASE_URL=postgresql://transcendence:transcendence_dev_only@database:5432/transcendence
FRONTEND_URL=https://localhost
BACKEND_URL=https://localhost/api

# Secrets placeholders
OAUTH42_CLIENT_ID=zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz
OAUTH42_CLIENT_SECRET=JJJJJJJJJJJJJJJJJJJJJJJJJJJJJJJJ

SESSION_SECRET=replace_me



#can be generated by:

#    └──>node
#    Welcome to Node.js v20.20.2.
#    > require('crypto').randomBytes(64).toString('hex')
#    'xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx...'

ACCESS_SECRET_TOKEN=replace_me
REFRESH_SECRET_TOKEN=replace_me
